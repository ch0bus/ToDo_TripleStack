FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY backend/django_api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY backend/django_api/ /app/
COPY deploy/entrypoint.sh /entrypoint.sh
COPY deploy/entrypoint-telegram.sh /entrypoint-telegram.sh
RUN chmod +x /entrypoint.sh /entrypoint-telegram.sh && mkdir -p /app/data /app/staticfiles

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]

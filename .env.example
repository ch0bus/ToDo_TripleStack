# Заняты: 80, 8003, 8005. Этот стек — 8006.
HOST_PORT=8006

# Длинная случайная строка: openssl rand -hex 32
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0

DJANGO_ALLOWED_HOSTS=62.182.102.210,localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://62.182.102.210:8006
DJANGO_CSRF_TRUSTED_ORIGINS=http://62.182.102.210:8006

# Срок JWT. По умолчанию access 12 ч, refresh 30 дней (ротация при обновлении).
# JWT_ACCESS_HOURS=12
# JWT_REFRESH_DAYS=30

# Telegram: токены задают пользователи в настройках. Это значения формы по умолчанию.
# TELEGRAM_TZ=Europe/Moscow
# TELEGRAM_DIGEST_HOUR=8
# TELEGRAM_REMIND_MINUTES=30
